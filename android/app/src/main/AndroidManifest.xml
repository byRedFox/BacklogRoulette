<?xml version="1.0" encoding="utf-8"?>
<!-- Интернет — для обложек (серверы картинок Steam, SteamGridDB со своим ключом). Встроенного браузера нет:
     ссылки открываются в браузере телефона или в приложении Steam.
     Состояние сети — чтобы качать обложки в фоне только по Wi-Fi. Фоновая служба и уведомление — чтобы подкачка
     обложек шла и при погасшем экране, с ходом загрузки в шторке (уведомления Android 13+ спрашивает отдельно,
     без них подкачка тоже идёт). Доступа ко всем файлам нет: файл с ПК Android отдаёт приложению только тот,
     что выбрал пользователь. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- «Нативные ИИ порты»: открыть системное окно установки и удаления порта. Ставит и удаляет сам Android —
         каждый раз после подтверждения пользователя; разрешение на установку пользователь выдаёт в настройках сам -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Страницы Steam — в приложении Steam, если оно стоит. Порты — только те, что в каталоге программы:
         Android сообщает только о перечисленных приложениях, остальные программе не видны -->
    <queries>
        <package android:name="com.valvesoftware.android.steam.community" />
        <package android:name="com.linkzenic.soh" />
    </queries>

    <application
        android:name=".BacklogApp"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BacklogRoulette">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Служба WorkManager для подкачки обложек: тип «синхронизация данных», как требует Android 14+ -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Скачанный APK порта — системному окну установки: только папка cache/ports, только на чтение,
             только на время установки -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ports"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/port_files" />
        </provider>
    </application>
</manifest>
